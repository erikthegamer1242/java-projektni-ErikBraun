<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="braun.erik.prijevoz.controller.MenuController">
    <MenuBar prefWidth="1920">
        <Menu mnemonicParsing="false" text="Driver">
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Search" id="driver_search"/>
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Add" id="driver_add"/>
        </Menu>
        <Menu mnemonicParsing="false" text="User">
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Search" id="user_search"/>
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Add" id="user_add"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Route">
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Search" id="route_search"/>
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Add" id="route_add"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Stop">
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Search" id="stop_search"/>
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Add" id="stop_add"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Vehicle">
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Search" id="vehicle_search"/>
            <MenuItem mnemonicParsing="false" onAction="#showScreen" text="Add" id="vehicle_add"/>
        </Menu>
    </MenuBar>
</AnchorPane>
